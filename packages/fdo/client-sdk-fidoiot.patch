-	}
-
-	cose_encrypt0->unprotected_header = fdo_alloc(sizeof(fdo_cose_encrypt0_unprotected_header_t));
-	if (!cose_encrypt0->unprotected_header) {
-		LOG(LOG_ERROR, "COSE_Encrypt0: Failed to alloc Unprotected header\n");
