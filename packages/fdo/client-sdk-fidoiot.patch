+		goto err;
+	}
+
+	ps->state = FDO_STATE_TO2_RCV_SETUP_DEVICE;
+	LOG(LOG_DEBUG, "TO2.DeviceServiceInfoReady completed successfully");
+	ret = 0; /* Mark as success */
+
+err:
+	if (hmac) {
+		fdo_hash_free(hmac);
+	}
+	return ret;
+}
