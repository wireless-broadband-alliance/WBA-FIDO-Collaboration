-static bool _STATE_TO2(void)
-{
-	fdo_prot_ctx_t *prot_ctx = NULL;
-	bool ret = false;
-
-	LOG(LOG_DEBUG, "\n-------------------------------------------"
-		       "-------------------------------------------"
-		       "-------------------------------------------"
-		       "-------------------------------------------\n"
-		       "                                             "
-		       "                                  Starting TO2\n"
-		       "-------------------------------------------"
-		       "-------------------------------------------"
-		       "-------------------------------------------"
