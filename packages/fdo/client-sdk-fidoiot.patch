+			if (prot_ctx->resolved_ip) {
+				fdo_free(prot_ctx->resolved_ip);
+			}
+			if (!resolve_dn(prot_ctx->host_dns,
+					&prot_ctx->resolved_ip,
+					prot_ctx->host_port,
+					(prot_ctx->tls ? &prot_ctx->ssl : NULL),
+					is_mfg_proxy_defined())) {
+				ret = false;
+
+			} else {
+			}
