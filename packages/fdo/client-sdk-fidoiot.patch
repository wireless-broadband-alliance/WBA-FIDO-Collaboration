+/*!
+ * \file
+ * \brief Abstraction layer for AES encryption routines of mbedTLS library.
+ */
+
+#include "mbedtls/aes.h"
+#include "mbedtls/md.h"
+#include "mbedtls/platform.h"
+#include "mbedtls/cipher.h"
+// #include "mbedtls/cipher_internal.h"
+
+#include "util.h"
+#include "fdoCryptoHal.h"
+#include "BN_support.h"
+#include "safe_lib.h"
+
+#ifdef AES_MODE_GCM_ENABLED
+// GCM mode enabled
+
+#ifdef AES_256_BIT
+// 256 bit keys
+#define CIPHER_TYPE MBEDTLS_CIPHER_AES_256_GCM
+#define KEY_LENGTH_LOCAL 32
+#else
+// 128 bit keys
+#define CIPHER_TYPE MBEDTLS_CIPHER_AES_128_GCM
+#define KEY_LENGTH_LOCAL 16
+#endif
+
+#define TAG_LENGTH AES_GCM_TAG_LEN
+#define IV_LENGTH AES_GCM_IV_LEN
+
+#define SET_IV EVP_CTRL_GCM_SET_IVLEN
+#define GET_TAG EVP_CTRL_GCM_GET_TAG
+#define SET_TAG EVP_CTRL_GCM_SET_TAG
+
+#else
+// CCM mode enabled
+
+#ifdef AES_256_BIT
+#define CIPHER_TYPE MBEDTLS_CIPHER_AES_256_CCM
+#define KEY_LENGTH_LOCAL 32 // 256 bits
+#else
+#define CIPHER_TYPE MBEDTLS_CIPHER_AES_128_CCM
+#define KEY_LENGTH_LOCAL 16 // 128 bit
+#endif
+
+#define TAG_LENGTH AES_CCM_TAG_LEN
+#define IV_LENGTH AES_CCM_IV_LEN
+// 'L' value of 8 octets. A change to this value MUST be matched with a
+// corresponding change of IV_LENGTH, 'N' to '15-L'. For example, for
+// L_VALUE_BYTES(L)=2, IV_LENGTH(N)=13
+#define L_VALUE_BYTES 8
+
+#define SET_IV EVP_CTRL_CCM_SET_IVLEN
+#define GET_TAG EVP_CTRL_CCM_GET_TAG
+#define SET_TAG EVP_CTRL_CCM_SET_TAG
+
+#endif
+
+/**
+ * crypto_hal_aes_encrypt -  Perform AES encryption of the input text.
+ *
+ * @param clear_text
+ *        Input text to be encrypted.
+ * @param clear_text_length
+ *        Plain text size in bytes.
+ * @param cipher_text
+ *        Encrypted text(output).
+ * @param cipher_length
+ *        Encrypted text size in bytes. [INOUT]
+ * @param block_size
+ *        AES encryption block size in bytes. always 128 bits.
+ * @param iv
+ *        AES encryption initialization vector.
+ * @param key
+ *        Key in Byte_array format used in encryption.
+ * @param key_length
+ *        Key size in Bytes.
+ * @return ret
+ *        return 0 on success. -1 on failure.
+ *        fills cipher_length in bytes while cipher_text passed as NULL, & all
+ *        other parameters are passed as it is.
+ */
+
+int32_t crypto_hal_aes_encrypt(const uint8_t *clear_text,
+			       uint32_t clear_text_length, uint8_t *cipher_text,
+			       uint32_t *cipher_length, size_t block_size,
+			       const uint8_t *iv, const uint8_t *key,
+			       uint32_t key_length, uint8_t *tag,
+			       size_t tag_length, const uint8_t *aad,
+			       size_t aad_length)
+{
+	int ret = -1;
+	static mbedtls_cipher_context_t cipher_ctx;
+	const mbedtls_cipher_info_t *cipher_info;
+	size_t num_bytes_written = 0;
+	size_t write_offset = 0;
+
+	/*
+	 * Check all parameters except cipher_text, as if it's NULL,
+	 * cipher_length needs to be filled in with the expected size
+	 */
+	if (!clear_text || !clear_text_length || !cipher_length ||
+	    FDO_AES_BLOCK_SIZE != block_size || !iv || !key ||
+	    KEY_LENGTH_LOCAL != key_length || !tag ||
+	    tag_length != TAG_LENGTH) {
+		LOG(LOG_ERROR, "Invalid parameters received");
+		goto end;
+	}
+
+	mbedtls_cipher_init(&cipher_ctx);
+
+	/**
+	 * @brief Fill in the expected cipher text length
+	 *
+	 */
+	if (cipher_text == NULL) {
+#ifdef AES_MODE_GCM_ENABLED
+		*cipher_length = clear_text_length;
+#endif
+#ifdef AES_MODE_CCM_ENABLED
+		static_assert(true, "AES-CCM not implemented yet!");
+#endif
+		ret = 0;
+		goto err;
+	}
+
+	/**
+	 * @brief Check cipher length.
+	 *
+	 */
+	if (*cipher_length < clear_text_length) {
+		LOG(LOG_ERROR, "Output buffer is not sufficient!");
+		goto err;
+	}
+
+	cipher_info = mbedtls_cipher_info_from_type(CIPHER_TYPE);
+	if (cipher_info == NULL) {
+		LOG(LOG_ERROR, "failed to get cipher info");
+		goto err;
+	}
+
+	if (mbedtls_cipher_setup(&cipher_ctx, cipher_info)) {
+		LOG(LOG_ERROR, "failed to setup the cipher");
+		goto err;
+	}
+
+	if (mbedtls_cipher_setkey(&cipher_ctx, key, 8 * key_length,
+				  MBEDTLS_ENCRYPT)) {
+		LOG(LOG_ERROR, "failed to set the key");
+		goto err;
+	}
+
+	if (mbedtls_cipher_set_iv(&cipher_ctx, iv, IV_LENGTH)) {
+		LOG(LOG_ERROR, "failed to set IV");
+		goto err;
+	}
+
+	if (mbedtls_cipher_reset(&cipher_ctx)) {
+		LOG(LOG_ERROR, "failed to reset the cipher");
+		goto err;
+	}
+
+	/**
+	 * @brief Specify AAD.
+	 *
+	 */
+	if (aad && aad_length > 0) {
+#ifdef AES_MODE_GCM_ENABLED
+		if (mbedtls_cipher_update_ad(&cipher_ctx, aad, aad_length)) {
+			LOG(LOG_ERROR, "AAD initialization failed!");
+			goto err;
+		}
+#endif
+#ifdef AES_MODE_CCM_ENABLED
+		static_assert(true, "AES-CCM not implemented yet!");
+#endif
+	}
+
+	if (mbedtls_cipher_update(&cipher_ctx, clear_text, clear_text_length,
+				  cipher_text + write_offset,
+				  &num_bytes_written)) {
+		LOG(LOG_ERROR, "cipher_update failed");
+		goto err;
+	}
+	write_offset += num_bytes_written;
+
+	if (mbedtls_cipher_finish(&cipher_ctx, cipher_text + write_offset,
+				  &num_bytes_written)) {
+		LOG(LOG_ERROR, "cipher failed");
+		goto err;
+	}
+	write_offset += num_bytes_written;
+
+	if (write_offset != clear_text_length) {
+		ret = -1;
+		goto err;
+	}
+
+	/**
+	 * @brief Get the TAG.
+	 *
+	 */
+	if (mbedtls_cipher_write_tag(&cipher_ctx, tag, tag_length)) {
+		LOG(LOG_ERROR, "can not get the TAG");
+		goto err;
+	}
+
+	*cipher_length = write_offset;
+	ret = 0;
+
+err:
+	mbedtls_cipher_free(&cipher_ctx);
+end:
+	return ret;
+}
+
+/**
+ * crypto_hal_aes_decrypt -  Perform AES ecryption of the cipher text.
+ *
+ * @param clear_text
+ *        Decrypted text(output).
+ * @param clear_text_length
+ *        Decrypted text size in Byte.
+ * @param cipher_text
+ *        Encrypted text(input).
+ * @param cipher_length
+ *        Encrypted text size in Byte.
+ * @param block_size
+ *        AES encryption block size in Byte. FDO_AES_BLOCK_SIZE
+ * @param iv
+ *        AES encryption initialization vector.
+ * @param key
+ *        Key in Byte_array format used in encryption.
+ * @param key_length
+ *        Key size in Bytes.
+ * @return ret
+ *        return 0 on success. -1 on failure.
+ *        fills clear_text_length in bytes for maximum possible buffer size
+ *        required to fill in the clear_text, when clear_text is passed as NULL
+ */
+int32_t crypto_hal_aes_decrypt(uint8_t *clear_text, uint32_t *clear_text_length,
+			       const uint8_t *cipher_text,
+			       uint32_t cipher_length, size_t block_size,
+			       const uint8_t *iv, const uint8_t *key,
+			       uint32_t key_length, uint8_t *tag,
+			       size_t tag_length, const uint8_t *aad,
+			       size_t aad_length)
+
+{
+	int ret = -1;
+	size_t num_bytes_written = 0;
+	size_t write_offset = 0;
+	static mbedtls_cipher_context_t cipher_ctx;
+	const mbedtls_cipher_info_t *cipher_info = NULL;
+
+	/* Check all the incoming parameters */
+	if (!clear_text_length || !cipher_text || !cipher_length ||
+	    FDO_AES_BLOCK_SIZE != block_size || !iv || !key ||
+	    KEY_LENGTH_LOCAL != key_length || !tag ||
+	    tag_length != TAG_LENGTH) {
+		LOG(LOG_ERROR, "Invalid paramters received");
+		goto end;
+	}
+
+	/**
+	 * @brief Fill in the expected cipher text length
+	 *
+	 */
+	if (clear_text == NULL) {
+#ifdef AES_MODE_GCM_ENABLED
+		*clear_text_length = cipher_length;
+#endif
+#ifdef AES_MODE_CCM_ENABLED
+		static_assert(true, "AES-CCM not implemented yet!");
+#endif
+		ret = 0;
+		goto end;
+	}
+
+	/**
+	 * @brief Check cipher length.
+	 *
+	 */
+	if (*clear_text_length < cipher_length) {
+		LOG(LOG_ERROR, "Output buffer is not sufficient!");
+		goto end;
+	}
+
+#if defined(AES_DEBUG)
+	HEXDUMP("Cipher txt to decrypt", cipher_text, cipher_length);
+#endif
+
+	/* Initialize the cipher context */
+	mbedtls_cipher_init(&cipher_ctx);
+
+	/* Setup the cipher context with cbc */
+	cipher_info = mbedtls_cipher_info_from_type(CIPHER_TYPE);
+
+	if (!cipher_info) {
+		LOG(LOG_ERROR, "Failed to find cipher type");
+		goto err;
+	}
+
+	if (mbedtls_cipher_setup(&cipher_ctx, cipher_info)) {
+		LOG(LOG_ERROR, "Failed to configure cipher with type");
+		goto err;
+	}
+
+	/* Set the key and iv on the context */
+	if (mbedtls_cipher_setkey(&cipher_ctx, key, 8 * key_length,
+				  MBEDTLS_DECRYPT)) {
+		LOG(LOG_ERROR, "Failed to set the key for decryption");
+		goto err;
+	}
+
+	if (mbedtls_cipher_set_iv(&cipher_ctx, iv, IV_LENGTH)) {
+		LOG(LOG_ERROR, "Failed to set IV for decryption");
+		goto err;
+	}
+
+	/**
+	 * @brief Specify AAD.
+	 *
+	 */
+
+#ifdef AES_MODE_GCM_ENABLED
+	if (mbedtls_cipher_update_ad(&cipher_ctx, aad, aad_length)) {
+		LOG(LOG_ERROR, "AAD initialization failed!");
+		goto end;
+	}
+#endif
+
+	/* Roll for decryption */
+	if (mbedtls_cipher_update(&cipher_ctx, cipher_text, cipher_length,
+				  clear_text + write_offset,
+				  &num_bytes_written)) {
+		LOG(LOG_ERROR, "Failed to decrypt cipher");
+		goto err;
+	}
+	write_offset += num_bytes_written;
+
+	if (mbedtls_cipher_finish(&cipher_ctx, clear_text + write_offset,
+				  &num_bytes_written)) {
+		LOG(LOG_ERROR, "Finishing cipher failed");
+		goto err;
+	}
+	write_offset += num_bytes_written;
+
+	/**
+	 * @brief Check the TAG.
+	 *
+	 */
+	ret = mbedtls_cipher_check_tag(&cipher_ctx, tag, tag_length);
+	if (ret) {
+		LOG(LOG_ERROR, "Check the TAG failed, e=0x%X", -ret);
+		goto err;
+	}
+
+	*clear_text_length = write_offset;
+	ret = 0; /* Mark as success */
+
+err:
+	mbedtls_cipher_free(&cipher_ctx);
+end:
+	return ret;
+}
