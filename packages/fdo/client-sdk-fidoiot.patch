- * @param buf_sz - size of the converted string
- * @return pointer to the converted string
- */
-char *fdo_nonce_to_string(uint8_t *n, char *buf, int buf_sz)
-{
-	int i = 0;
-	char *a = (char *)n;
-
-	(void)buf_sz; /* FIXME: Change the signature as its unused */
-
-	if (!n || !buf) {
