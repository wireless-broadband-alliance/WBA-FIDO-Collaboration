-	}
-
-	size += size_owner_random;
-
-	key_ex_data->_shared_secret_length = size;
-	key_ex_data->_shared_secret = shse;
-	LOG(LOG_DEBUG, "She_she size= %x, ", size);
-
-	ret = 0; /* Mark as success */
-
-exit:
-	if (ret && shse) {
