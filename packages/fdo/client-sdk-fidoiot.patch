+
+	if (rv->ip != NULL) {
+		fdo_free(rv->ip);
+	}
+
+	if (rv->po != NULL) {
+		fdo_free(rv->po);
+	}
+
+	if (rv->pow != NULL) {
+		fdo_free(rv->pow);
+	}
+
+	if (rv->dn != NULL) {
+		fdo_string_free(rv->dn);
+	}
+
+	if (rv->sch != NULL) {
