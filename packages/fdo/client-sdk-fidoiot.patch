+/*!
+ * \file
+ * \ brief Abstraction layer for ECDSA signature verification
+ * \ routines of mbedTLS library.
+ */
+
+#include "mbedtls/ctr_drbg.h"
+#include "mbedtls/sha256.h"
+#include "mbedtls/platform.h"
+#include <mbedtls/ecdsa.h>
+#include <mbedtls/pk.h>
+#include <mbedtls/asn1write.h>
+#include <mbedtls/error.h>
+
+#include "safe_lib.h"
+#include "fdoCryptoHal.h"
+#include "util.h"
+#include "stdlib.h"
+#include "storage_al.h"
+
+static int ecdsa_signature_to_asn1( const mbedtls_mpi *r, const mbedtls_mpi *s,
+                                    unsigned char *sig, size_t sig_size,
+                                    size_t *slen )
+{
+    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
+    unsigned char buf[MBEDTLS_ECDSA_MAX_LEN] = {0};
+    unsigned char *p = buf + sizeof( buf );
+    size_t len = 0;
+
+    MBEDTLS_ASN1_CHK_ADD( len, mbedtls_asn1_write_mpi( &p, buf, s ) );
+    MBEDTLS_ASN1_CHK_ADD( len, mbedtls_asn1_write_mpi( &p, buf, r ) );
+
+    MBEDTLS_ASN1_CHK_ADD( len, mbedtls_asn1_write_len( &p, buf, len ) );
+    MBEDTLS_ASN1_CHK_ADD( len, mbedtls_asn1_write_tag( &p, buf,
+                                       MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE ) );
+
+    if( len > sig_size )
+        return( MBEDTLS_ERR_ECP_BUFFER_TOO_SMALL );
+
+    memcpy( sig, p, len );
+    *slen = len;
+
+    return( 0 );
+}
+
+/**
+ * Verify an ECC P-256/P-384 signature using provided ECDSA Public Keys.
+ * @param key_encoding - encoding typee.
+ * @param key_algorithm - public key algorithm.
+ * @param message - pointer of type uint8_t, holds the encoded message.
+ * @param message_length - size of message, type size_t.
+ * @param message_signature - pointer of type uint8_t, holds a valid
+ *			ecdsa signature in big-endian format
+ * @param signature_length - size of signature, type unsigned int.
+ * @param key_param1 - pointer of type uint8_t, holds the EC public key.
+ * @param key_param1Length - size of EC public key, type size_t.
+ * @param key_param2 - not used.
+ * @param key_param2Length - not used
+ * @return 0 if true, else -1.
+
+ */
+int32_t crypto_hal_sig_verify(uint8_t key_encoding, int key_algorithm,
+			      const uint8_t *message, uint32_t message_length,
+			      const uint8_t *message_signature,
+			      uint32_t signature_length,
+			      const uint8_t *key_param1,
+			      uint32_t key_param1Length,
+			      const uint8_t *key_param2,
+			      uint32_t key_param2Length)
+{
+	int32_t ret = -1;
+	int result = 0;
+	unsigned char hash[SHA512_DIGEST_SIZE] = {0};
+	size_t hash_length = 0;
+	mbedtls_ecdsa_context ec_ctx = {0};
+	mbedtls_pk_context pk_ctx = {0};
+	mbedtls_mpi r, s;
+	mbedtls_md_type_t mbedhash_type = MBEDTLS_MD_NONE;
+	uint8_t *local_message_signature = NULL;
+	size_t local_message_signature_length = 0;
+
+	(void)key_param2;
+	(void)key_param2Length;
+
+	if ((key_encoding != FDO_CRYPTO_PUB_KEY_ENCODING_X509 &&
+		key_encoding != FDO_CRYPTO_PUB_KEY_ENCODING_COSEX509) ||
+	    (key_algorithm != FDO_CRYPTO_PUB_KEY_ALGO_ECDSAp256 &&
+	     key_algorithm != FDO_CRYPTO_PUB_KEY_ALGO_ECDSAp384)) {
+		LOG(LOG_ERROR, "Incorrect key type!");
+		goto end;
+	}
+
+	if (NULL == key_param1 || 0 == key_param1Length ||
+	    NULL == message_signature || 0 == signature_length ||
+	    NULL == message || 0 == message_length) {
+		LOG(LOG_ERROR, "Invalid arguments!");
+		goto end;
+	}
+
+	/* Initialize mbedtls_ecdsa_context with EC group */
+	mbedtls_ecdsa_init(&ec_ctx);
+
+	if (key_algorithm == FDO_CRYPTO_PUB_KEY_ALGO_ECDSAp256) { // P-256 NIST
+		LOG(LOG_DEBUG, "ECDSA256 verify");
+		result = mbedtls_ecp_group_load(&(ec_ctx.MBEDTLS_PRIVATE(grp)),
+						MBEDTLS_ECP_DP_SECP256R1);
+		mbedhash_type = MBEDTLS_MD_SHA256;
+		hash_length = SHA256_DIGEST_SIZE;
+	} else { // P-384 NIST curve
+		LOG(LOG_DEBUG, "ECDSA384 verify");
+		result = mbedtls_ecp_group_load(&(ec_ctx.MBEDTLS_PRIVATE(grp)),
+						MBEDTLS_ECP_DP_SECP384R1);
+
+		mbedhash_type = MBEDTLS_MD_SHA384;
+		hash_length = SHA384_DIGEST_SIZE;
+	}
+	if (result) {
+		LOG(LOG_ERROR, "Initializing with required EC group failed!");
+		goto end;
+	}
+
+	/* Initialize mbedtls_pk_context with incoming EC public-key */
+	mbedtls_pk_init(&pk_ctx);
+
+	/**
+	 * @brief Parse public key with encoding FDO_CRYPTO_PUB_KEY_ENCODING_X509.
+	 * 
+	 */
+	if (key_encoding == FDO_CRYPTO_PUB_KEY_ENCODING_X509) {
+		result = mbedtls_pk_parse_public_key(&pk_ctx,
+							(const unsigned char *)key_param1,
+							(size_t)key_param1Length);
+		if (result != 0) {
+			LOG(LOG_ERROR, "Parsing EC public-key failed!");
+			goto end;
+		}
+	}
+
+	/**
+	 * @brief Parse public key with encoding FDO_CRYPTO_PUB_KEY_ENCODING_COSEX509.
+	 * 
+	 */
+	if (key_encoding == FDO_CRYPTO_PUB_KEY_ENCODING_COSEX509) {
+
+		/**
+		 * @brief Setup pk context.
+		 * 
+		 */
+		result = mbedtls_pk_setup(&pk_ctx, mbedtls_pk_info_from_type(MBEDTLS_PK_ECDSA));
+		if (result != 0) {
+			LOG(LOG_ERROR, "Setup public key context failed, e=%d", result);
+			goto end;
+		}
+		
+		/**
+		 * @brief Parse point.
+		 * 		 @param				
+		 */
+		MBEDTLS_MPI_CHK(mbedtls_mpi_read_binary(&mbedtls_pk_ec(pk_ctx)->MBEDTLS_PRIVATE(Q).MBEDTLS_PRIVATE(X), key_param1, key_param1Length / 2));
+		MBEDTLS_MPI_CHK(mbedtls_mpi_read_binary(&mbedtls_pk_ec(pk_ctx)->MBEDTLS_PRIVATE(Q).MBEDTLS_PRIVATE(Y), key_param1 + key_param1Length / 2, key_param1Length / 2));
+		MBEDTLS_MPI_CHK(mbedtls_mpi_lset(&mbedtls_pk_ec(pk_ctx)->MBEDTLS_PRIVATE(Q).MBEDTLS_PRIVATE(Z), 1));
+	}
+
+	/**
+	 * @brief Check public key.
+	 * 
+	 */
+	result = mbedtls_ecp_check_pubkey(&mbedtls_pk_ec(pk_ctx)->MBEDTLS_PRIVATE(grp), &mbedtls_pk_ec(pk_ctx)->MBEDTLS_PRIVATE(Q));
+	if (result != 0) {
+		LOG(LOG_ERROR, "Invalid EC public key, e=%d", result);
+		goto end;
+	}
+
+	/* Calculate the hash over message and sign that hash */
+	if (mbedtls_md(mbedtls_md_info_from_type(mbedhash_type),
+		       (const uint8_t *)message, message_length, hash) != 0) {
+		LOG(LOG_ERROR, " mbedtls_md FAILED:");
+		goto end;
+	}
+
+	local_message_signature = (uint8_t *)fdo_alloc(BUFF_SIZE_256_BYTES);
+
+	/**
+	 * @brief Init r, s.
+	 * 
+	 */
+	mbedtls_mpi_init(&r);
+	mbedtls_mpi_init(&s);
+
+	/**
+	 * @brief Check signature length.
+	 * 
+	 */
+	if (signature_length != hash_length * 2) {
+		LOG(LOG_ERROR, "Invalid signature length");
+		goto end;
+	}
+
+	/**
+	 * @brief Parse r|s from the signature.
+	 * 
+	 */
+	result = mbedtls_mpi_read_binary(&r, message_signature, hash_length);
+	result |= mbedtls_mpi_read_binary(&s, (message_signature + hash_length), hash_length);
+	if (result != 0) {
+		LOG(LOG_ERROR, "Can not parse signature");
+		goto end;
+	}
+
+	/**
+	 * @brief Convert the signature to ASN.1 structure.
+	 * 
+	 */
+	if (!ecdsa_signature_to_asn1(&r, &s, local_message_signature, signature_length, &local_message_signature_length)) {
+		LOG(LOG_ERROR, "Invalid signature");
+		goto end;
+	}
+
+	/* Verify ECDSA signature with 'updated mbedtls_ecdsa_context with
+	 * pubkey info'
+	 */
+	ret = mbedtls_ecdsa_read_signature(mbedtls_pk_ec(pk_ctx), hash,
+					   hash_length, local_message_signature,
+					   local_message_signature_length);
+	if (ret != 0) {
+		LOG(LOG_ERROR, "ECDSA Signature-verification failed!");
+		goto end;
+	}
+
+	ret = 0;
+
+end:
+cleanup:
+	if (local_message_signature) {
+		fdo_free(local_message_signature);
+	}
+	mbedtls_ecdsa_free(&ec_ctx);
+	mbedtls_pk_free(&pk_ctx);
+	return ret;
+}
