+/** 
+ * Write a RendezvousInstr object to the output buffer
+ * RendezvousInstr = [
+ *   RVVariable,
+ *   RVValue
+ * ]
+ *
+ * @param fdow - the buffer pointer
+ * @param rv - pointer to the RendezvousInstr object to write
+ * @return true if written successfully, otherwise false
+ */
+bool fdo_rendezvous_write(fdow_t *fdow, fdo_rendezvous_t *rv)
+{
+	if (!fdow || !rv) {
+		return false;
+	}
+	
+	if (!fdow_start_array(fdow, rv->num_params)) {
+		LOG(LOG_ERROR, "RendezvousInstr: Failed to start array");
+		return false;
+	}
+
+	if (rv->dev_only != NULL && *rv->dev_only == true) {
+		if (!fdow_signed_int(fdow, RVDEVONLY)) {
+			LOG(LOG_ERROR, "RendezvousInstr: Failed to write RVDevOnly");
+			return false;
+		}
+	}
+
+	if (rv->owner_only != NULL && *rv->owner_only == true) {
+		if (!fdow_signed_int(fdow, RVOWNERONLY)) {
+			LOG(LOG_ERROR, "RendezvousInstr: Failed to write RVOwnerOnly");
+			return false;
+		}
+	}
+
+	if (rv->ip != NULL) {
+		if (!fdow_signed_int(fdow, RVIPADDRESS) ||
+			!fdow_byte_string(fdow, (uint8_t *) &rv->ip->addr, rv->ip->length)) {
+			LOG(LOG_ERROR, "RendezvousInstr: Failed to write RVIPAddress");
+			return false;
+		}
+	}
+
+	if (rv->po != NULL) {
+		if (!fdow_signed_int(fdow, RVDEVPORT) ||
+			!fdow_signed_int(fdow, *rv->po)) {
+			LOG(LOG_ERROR, "RendezvousInstr: Failed to write RVDevPort");
+			return false;
+		}
+	}
+
+	if (rv->pow != NULL) {
+		if (!fdow_unsigned_int(fdow, RVOWNERPORT) ||
+			!fdow_signed_int(fdow, *rv->pow)) {
+			LOG(LOG_ERROR, "RendezvousInstr: Failed to write RVOwnerPort");
+			return false;
+		}
+	}
+
+	if (rv->dn != NULL) {
+		if (!fdow_signed_int(fdow, RVDNS) ||
+			!fdow_text_string(fdow, rv->dn->bytes, rv->dn->byte_sz)) {
+			LOG(LOG_ERROR, "RendezvousInstr: Failed to write RVDns");
+			return false;
+		}
+	}
+
+	if (rv->sch != NULL) {
+		if (!fdow_signed_int(fdow, RVSVCERTHASH) ||
+			!fdo_hash_write(fdow, rv->sch)) {
+			LOG(LOG_ERROR, "RendezvousInstr: Failed to write RVSvCertHash");
+			return false;
+		}
+	}
+
+	if (rv->cch != NULL) {
+		if (!fdow_signed_int(fdow, RVCLCERTHASH) ||
+			!fdo_hash_write(fdow, rv->cch)) {
+			LOG(LOG_ERROR, "RendezvousInstr: Failed to write RVClCertHash");
+			return false;
+		}
+	}
+
+	if (rv->ui != NULL) {
+		if (!fdow_signed_int(fdow, RVUSERINPUT) ||
+			!fdow_boolean(fdow, *rv->ui)) {
+			LOG(LOG_ERROR, "RendezvousInstr: Failed to write RVUserInput");
+			return false;
+		}
+	}
+
+	if (rv->ss != NULL) {
+		if (!fdow_signed_int(fdow, RVWIFISSID) ||
+			!fdow_text_string(fdow, rv->ss->bytes, rv->ss->byte_sz)) {
+			LOG(LOG_ERROR, "RendezvousInstr: Failed to write RVWiFiSsid");
+			return false;
+		}
+	}
+
+	if (rv->pw != NULL) {
+		if (!fdow_signed_int(fdow, RVWIFIPW) ||
+			!fdow_text_string(fdow, rv->pw->bytes, rv->pw->byte_sz)) {
+			LOG(LOG_ERROR, "RendezvousInstr: Failed to write RVWifiPw");
+			return false;
+		}
+	}
+
+	if (rv->me != NULL) {
+		if (!fdow_signed_int(fdow, RVMEDIUM) ||
+			!fdow_unsigned_int(fdow, *rv->me)) {
+			LOG(LOG_ERROR, "RendezvousInstr: Failed to write RVMedium");
+			return false;
+		}
+	}
+
+	if (rv->pr != NULL) {
+		if (!fdow_signed_int(fdow, RVPROTOCOL) ||
+			!fdow_unsigned_int(fdow, *rv->pr)) {
+			LOG(LOG_ERROR, "RendezvousInstr: Failed to write RVProtocol");
+			return false;
+		}
+	}
+
+	if (rv->delaysec != NULL) {
+		if (!fdow_signed_int(fdow, RVDELAYSEC) ||
+			!fdow_unsigned_int(fdow, *rv->delaysec)) {
+			LOG(LOG_ERROR, "RendezvousInstr: Failed to write RVDelaysec");
+			return false;
+		}
+	}
+
+	if (rv->bypass != NULL && *rv->bypass == true) {
+		if (!fdow_signed_int(fdow, RVBYPASS)) {
+			LOG(LOG_ERROR, "RendezvousInstr: Failed to write RVBypass");
+			return false;
+		}
+	}
+
+	if (!fdow_end_array(fdow)) {
+		LOG(LOG_ERROR, "RendezvousInstr: Failed to end array");
+		return false;
+	}
+	return true;
+}
+
+/**
+ * Read the RendezvousInstr from the input buffer
+ * RendezvousInstr = [
+ *   RVVariable,
+ *   RVValue
+ * ]
+ *
+ * @param fdor - the input buffer object
+ * @param rv - pointer to the RendezvousInstr object to fill
+ * @return true of read correctly, false otherwise
+ */
+bool fdo_rendezvous_read(fdor_t *fdor, fdo_rendezvous_t *rv)
+{
+	int ret = true;
+
+	if (!fdor || !rv) {
+		return false;
+	}
+
+	size_t num_rv_instr_items = 0;
+	if (!fdor_array_length(fdor, &num_rv_instr_items) || num_rv_instr_items <= 0) {
+		LOG(LOG_ERROR, "RendezvousInstr is empty");
+		return false;
+	}
+
+	if (!fdor_start_array(fdor)) {
+		LOG(LOG_ERROR, "RendezvousInstr start array not found");
+		return false;
+	}
+	
+	// size_t index;
+	size_t key_buf_sz = 24;
+	char key_buf[key_buf_sz];
+	size_t str_buf_sz = 80;
+	char str_buf[str_buf_sz];
+
+	rv->num_params = 0;
+
+	if (memset_s(key_buf, key_buf_sz, 0) != 0) {
+		LOG(LOG_ERROR, "Memset Failed");
+		return false;
+	}
+	if (memset_s(str_buf, str_buf_sz, 0) != 0) {
+		LOG(LOG_ERROR, "Memset Failed");
+		return false;
+	}
+	int key;
+	if (!fdor_signed_int(fdor, &key)) {
+		LOG(LOG_ERROR, "RendezvousInstr key read error");
+		ret = false;
+	}
+	// Parse the values found
+	switch (key) {
+	case RVDEVONLY:
+		rv->dev_only = fdo_alloc(sizeof(bool));
+		if (!rv->dev_only) {
+			LOG(LOG_ERROR, "RVDEVONLY alloc failed");
+			ret = false;
+			break;
+		}
+		*rv->dev_only = true;
+		rv->num_params = 1;
+		break;
+
+	case RVOWNERONLY:
+		rv->owner_only = fdo_alloc(sizeof(bool));
+		if (!rv->owner_only) {
+			LOG(LOG_ERROR, "RVOWNERONLY alloc failed");
+			ret = false;
+			break;
+		}
+		*rv->owner_only = true;
+		rv->num_params = 1;
+		break;
+
+	case RVIPADDRESS:
+		if (rv->ip) {
+			fdo_free(rv->ip);
+		}
+
+		rv->ip = fdo_ipaddress_alloc();
+		if (!rv->ip) {
+			LOG(LOG_ERROR, "RVIPADDRESS alloc failed");
+			ret = false;
+			break;
+		}
+		if (fdo_read_ipaddress(fdor, rv->ip) != true) {
+			LOG(LOG_ERROR, "RVIPADDRESS read failed");
+			ret = false;
+		}
+		rv->num_params = 2;
+		break;
+
+	case RVDEVPORT:
+
+		if (rv->po) {
+			fdo_free(rv->po);
+		}
+
+		rv->po = fdo_alloc(sizeof(int)); // Allocate an integer
+		if (!rv->po) {
+			LOG(LOG_ERROR, "RVDEVPORT alloc failed");
+			ret = false;
+			break;
+		}
+		if (!fdor_signed_int(fdor, rv->po)) {
+			LOG(LOG_ERROR, "RVDEVPORT read failed");
+			ret = false;
+		}
+		rv->num_params = 2;
+		break;
+
+	// valid only for OWNER. parse for validation.
+	case RVOWNERPORT:
+
+		if (rv->pow) {
+			fdo_free(rv->pow);
+		}
+
+		rv->pow = fdo_alloc(sizeof(int));
+		if (!rv->pow) {
+			LOG(LOG_ERROR, "RVOWNERPORT alloc failed");
+			ret = false;
+			break;
+		}
+		if (!fdor_signed_int(fdor, rv->pow)) {
+			LOG(LOG_ERROR, "RVOWNERPORT read failed");
+			ret = false;
+		}
+		rv->num_params = 2;
+		break;
+
+	case RVDNS:
+
+		if (!fdor_string_length(fdor, &str_buf_sz)) {
+			LOG(LOG_ERROR, "RVDNS length read failed");
+			return false;
+		}
+
+		if (!fdor_text_string(fdor, str_buf, str_buf_sz)) {
+			LOG(LOG_ERROR, "RVDNS read failed");
+			return false;
+		}
+
+		if (rv->dn) {
+			fdo_string_free(rv->dn);
+		}
+
+		rv->dn = fdo_string_alloc_with(str_buf, str_buf_sz);
+		if (!rv->dn) {
+			LOG(LOG_ERROR, "RVDNS alloc failed");
+			ret = false;
+		}
+		rv->num_params = 2;
+		break;
+
+	case RVSVCERTHASH:
+
+		if (rv->sch) {
+			fdo_hash_free(rv->sch);
+		}
+		rv->sch = fdo_hash_alloc_empty();
+		if (!rv->sch) {
+			LOG(LOG_ERROR, "RVSVCERTHASH alloc failed");
+			ret = false;
+			break;
+		}
+		if (!fdo_hash_read(fdor, rv->sch)) {
+			LOG(LOG_ERROR, "RVSVCERTHASH read failed");
+			ret = false;
+		}
+		rv->num_params = 2;
+		break;
+
+	case RVCLCERTHASH:
+
+		if (rv->cch) {
+			fdo_hash_free(rv->cch);
+		}
+
+		rv->cch = fdo_hash_alloc_empty();
+		if (!rv->cch) {
+			LOG(LOG_ERROR, "RVCLCERTHASH alloc failed");
+			ret = false;
+			break;
+		}
+		if (!fdo_hash_read(fdor, rv->cch)) {
+			LOG(LOG_ERROR, "RVSVCERTHASH read failed");
+			ret = false;
+		}
+		rv->num_params = 2;
+		break;
+
+	case RVUSERINPUT:
+
+		rv->ui = fdo_alloc(sizeof(bool));
+		if (!rv->ui) {
+			LOG(LOG_ERROR, "RVUSERINPUT alloc failed");
+			ret = false;
+			break;
+		}
+		if (!fdor_boolean(fdor, rv->ui)) {
+			LOG(LOG_ERROR, "RVUSERINPUT read failed");
+			ret = false;
+		}
+		rv->num_params = 2;
+		break;
+
+	case RVWIFISSID:
+
+		if (!fdor_string_length(fdor, &str_buf_sz)) {
+			LOG(LOG_ERROR, "RVWIFISSID length read failed");
+			ret = false;
+		}
+
+		if (fdor_text_string(fdor, str_buf, str_buf_sz)) {
+			LOG(LOG_ERROR, "RVWIFISSID length read failed");
+			return false;
+		}
+
+		if (rv->ss) {
+			fdo_string_free(rv->ss);
+		}
+		rv->ss = fdo_string_alloc_with(str_buf, str_buf_sz);
+		if (!rv->ss) {
+			LOG(LOG_ERROR, "RVWIFISSID alloc failed");
+			ret = false;
+		}
+		rv->num_params = 2;
+		break;
+
+	case RVWIFIPW:
+
+		if (!fdor_string_length(fdor, &str_buf_sz)) {
+			LOG(LOG_ERROR, "RVWIFIPW length read failed");
+			ret = false;
+		}
+
+		if (!fdor_text_string(fdor, str_buf, str_buf_sz)) {
+			LOG(LOG_ERROR, "RVWIFIPW read failed");
+			ret = false;
+		}
+
+		if (rv->pw) {
+			fdo_string_free(rv->pw);
+		}
+
+		rv->pw = fdo_string_alloc_with(str_buf, str_buf_sz);
+		if (!rv->pw) {
+			LOG(LOG_ERROR, "RVWIFIPW alloc failed");
+			ret = false;
+		}
+		rv->num_params = 2;
+		break;
+
+	case RVMEDIUM:
+
+		rv->me = fdo_alloc(sizeof(uint64_t));
+		if (!fdor_unsigned_int(fdor, rv->me)) {
+			LOG(LOG_ERROR, "RVMEDIUM read failed");
+			ret = false;
+		}
+		// TO-DO : Parse all possible RVMedium values.
+		rv->num_params = 2;
+		break;
+
+	case RVPROTOCOL:
+
+		rv->pr = fdo_alloc(sizeof(uint64_t));
+		if (!fdor_unsigned_int(fdor, rv->pr)) {
+			LOG(LOG_ERROR, "RVPROTOCOL read failed");
+			ret = false;
+		}
+		// TO-DO : Parse all possible RVProtocol values.
+		rv->num_params = 2;
+		break;
+
+	case RVDELAYSEC:
+
+		if (rv->delaysec) {
+			fdo_free(rv->delaysec);
+		}
+
+		rv->delaysec = fdo_alloc(sizeof(uint64_t));
+		if (!rv->delaysec) {
+			LOG(LOG_ERROR, "RVDELAYSEC Alloc failed");
+			return false;
+		}
+		if (!fdor_unsigned_int(fdor, rv->delaysec) || !rv->delaysec) {
+			LOG(LOG_ERROR, "RVDELAYSEC read failed");
+			ret = false;
+		}
+		rv->num_params = 2;
+		break;
+
+	case RVBYPASS:
+
+		rv->bypass = fdo_alloc(sizeof(bool));
+		if (!rv->bypass) {
+			LOG(LOG_ERROR, "RVBYPASS alloc failed");
+			ret = false;
+			break;
+		}
+		*rv->bypass = true;
+		rv->num_params = 1;
+		break;
+
+	case RVEXTRV:
+		// TO-DO: Parse as an array. Implementation is open for now.
+		break;
+
+	default:
+		LOG(LOG_ERROR,
+		    "%s : Invalid RendezvousInstr Entry Type %s\n",
+			    __func__, key_buf);
+		ret = false; // Abort due to unexpected value for key
+		break;
+	}
+
+	if (!fdor_end_array(fdor)) {
+		LOG(LOG_ERROR, "RendezvousInstr end array not found");
+		ret = false;
+	}
+
+	return ret;
+}
