+	if (!fdow || !fdow->current) {
+		LOG(LOG_ERROR, "CBOR encoder: Invalid params");
+		return false;
+	}
+	if (cbor_encode_text_string(&fdow->current->cbor_encoder, bytes, byte_sz) != CborNoError) {
+		LOG(LOG_ERROR, "CBOR encoder: Failed to write Major Type 3 (tstr)");
