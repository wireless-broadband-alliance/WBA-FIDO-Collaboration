+/*
+ * Copyright 2020 Intel Corporation
+ * SPDX-License-Identifier: Apache 2.0
+ */
+
+/*!
+ * \file
+ * \ brief Abstraction layer for ECDSA signature (signing)
+ * \ routines of mbedTLS library.
+ */
+
+#include "mbedtls/ctr_drbg.h"
+#include "mbedtls/sha256.h"
+#include "mbedtls/platform.h"
+#include "mbedtls/ecdsa.h"
+#include "mbedtls/asn1.h"
+
+#include "safe_lib.h"
+#include "fdoCryptoHal.h"
+#include "util.h"
+#include "stdlib.h"
+#include "storage_al.h"
+#include "mbedtls_random.h"
+#include "ecdsa_privkey.h"
+
+/**
+ * Sign a message using provided ECDSA Private Keys.
+ * @param data - pointer of type uint8_t, holds the plaintext message.
+ * @param data_len - size of message, type size_t.
+ * @param message_signature - pointer of type unsigned char, which will be
+ * by filled with signature.
+ * @param signature_length - size of signature, type unsigned int.
+ * @return 0 if true, else -1.
+ */
+int32_t crypto_hal_ecdsa_sign(const uint8_t *data, size_t data_len,
+			      unsigned char *message_signature,
+			      size_t *signature_length)
+{
+	int ret = -1;
+	int retval = -1;
+	size_t len;
+	mbedtls_mpi r, s;
+	const uint8_t *end = NULL;
+	uint8_t *p = NULL;
+	mbedtls_ecdsa_context ctx_sign = {0};
+	mbedtls_ctr_drbg_context *drbg_ctx = get_mbedtls_random_ctx();
+	unsigned char hash[SHA512_DIGEST_SIZE] = {0};
+	unsigned char *privkey = NULL;
+	size_t privkeysize = 0;
+#if !defined(ECDSA_PEM)
+	mbedtls_mpi d = {0};
+#else
+	mbedtls_pk_context pk_ctx = {0};
+	mbedtls_ecp_keypair *ecp = NULL;
+#endif
+	mbedtls_md_type_t hash_type = MBEDTLS_MD_NONE;
+	size_t hash_length = 0;
+	uint32_t curvetype = 0;
+
+	if (!data || !data_len || !message_signature || !signature_length ||
+	    !drbg_ctx) {
+		LOG(LOG_ERROR, "fdo_cryptoDSASign params not valid");
+		ret = -1;
+		goto end;
+	}
+
+	mbedtls_ecdsa_init(&ctx_sign);
+
+#if defined(ECDSA256_DA)
+	hash_type = MBEDTLS_MD_SHA256;
+	hash_length = SHA256_DIGEST_SIZE;
+	curvetype = MBEDTLS_ECP_DP_SECP256R1;
+#elif defined(ECDSA384_DA)
+	hash_type = MBEDTLS_MD_SHA384;
+	hash_length = SHA384_DIGEST_SIZE;
+	curvetype = MBEDTLS_ECP_DP_SECP384R1;
+#endif
+
+	/* Calculate the hash over message and sign that hash */
+	retval = mbedtls_md(mbedtls_md_info_from_type(hash_type), data,
+			    data_len, hash);
+	if (retval != 0) {
+		LOG(LOG_ERROR, " mbedtls_md FAILED:%d", retval);
+		goto end;
+	}
+
+	retval =
+	    mbedtls_ecp_group_load(&ctx_sign.MBEDTLS_PRIVATE(grp), curvetype);
+	if (retval != 0) {
+		LOG(LOG_ERROR, "signatur_ecp_group_load FAILED:%d", retval);
+		goto end;
+	}
+
+	/* Load the EC private key from storage */
+	retval = load_ecdsa_privkey(&privkey, &privkeysize);
+	if (retval) {
+		LOG(LOG_ERROR, "No valid EC private key present");
+		goto end;
+	}
+
+#if !defined(ECDSA_PEM)
+
+	// Load private key from buffer to mbedtls mpi
+	retval = mbedtls_mpi_read_binary(&d, privkey, (int)privkeysize);
+	if (retval != 0) {
+		LOG(LOG_ERROR,
+		    "Reading private key from buf to mbedtls structure:%d",
+		    retval);
+		goto end;
+	}
+	ctx_sign.MBEDTLS_PRIVATE(d) = d;
+#else // use ecdsa pem file
+	mbedtls_pk_init(&pk_ctx);
+
+	// parse key api expect NULL char at the end
+#ifdef MBEDTLS_VERSION_2
+	retval = mbedtls_pk_parse_key(&pk_ctx, privkey, privkeysize, NULL, 0);
+#else
+	retval = mbedtls_pk_parse_key(&pk_ctx, privkey, privkeysize, NULL, 0,
+				      mbedtls_ctr_drbg_random, drbg_ctx);
+#endif
+	if (retval != 0) {
+		LOG(LOG_ERROR, "Parsing key from buf failed:%d", retval);
+		goto end;
+	}
+
+	/* From the EC keypair, get the private key */
+	ecp = mbedtls_pk_ec(pk_ctx);
+	retval =
+	    mbedtls_mpi_copy(&(ctx_sign.MBEDTLS_PRIVATE(d)),
+			     (const mbedtls_mpi *)&(ecp->MBEDTLS_PRIVATE(d)));
+	if (ecp == NULL || retval != 0) {
+		goto end;
+	}
+#endif
+
+	// Generate Signature
+#ifdef MBEDTLS_VERSION_2
+	retval = mbedtls_ecdsa_write_signature(
+	    &ctx_sign, hash_type, hash, hash_length, message_signature,
+	    *signature_length, mbedtls_ctr_drbg_random, drbg_ctx);
+#else
+	retval = mbedtls_ecdsa_write_signature(
+	    &ctx_sign, hash_type, hash, hash_length, message_signature,
+	    *signature_length, signature_length, mbedtls_ctr_drbg_random,
+	    drbg_ctx);
+#endif
+	if (retval != 0) {
+		LOG(LOG_ERROR, "signature creation failed ret:%d", retval);
+		goto end;
+	}
+
+	/**
+	 * @brief Decode signature from DER to raw.
+	 *
+	 */
+	p = message_signature;
+	end = message_signature + *signature_length;
+
+	/**
+	 * @brief Init r, s.
+	 *
+	 */
+	mbedtls_mpi_init(&r);
+	mbedtls_mpi_init(&s);
+
+	/**
+	 * @brief Check asn1 tag.
+	 *
+	 */
+	retval = mbedtls_asn1_get_tag(
+	    &p, end, &len, MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE);
+	if (retval != 0) {
+		LOG(LOG_ERROR, "failed at tag for signature %d", ret);
+		ret = -1;
+		goto end;
+	}
+
+	/**
+	 * @brief Extract r, s.
+	 *
+	 */
+	MBEDTLS_MPI_CHK(mbedtls_asn1_get_mpi(&p, end, &r));
+	MBEDTLS_MPI_CHK(mbedtls_asn1_get_mpi(&p, end, &s));
+
+	/**
+	 * @brief Concat r | s.
+	 *
+	 */
+	MBEDTLS_MPI_CHK(
+	    mbedtls_mpi_write_binary(&r, message_signature, hash_length));
+	MBEDTLS_MPI_CHK(mbedtls_mpi_write_binary(
+	    &s, message_signature + hash_length, hash_length));
+
+	/**
+	 * @brief Mark as success.
+	 *
+	 */
+	ret = 0;
+	*signature_length = hash_length * 2;
+
+end:
+cleanup:
+	mbedtls_mpi_free(&r);
+	mbedtls_mpi_free(&s);
+	mbedtls_ecdsa_free(&ctx_sign);
+#if defined(ECDSA_PEM)
+	mbedtls_pk_free(&pk_ctx);
+#endif
+	if (privkey) {
+		if (memset_s(privkey, privkeysize, 0) != 0) {
+			LOG(LOG_ERROR, "Memset Failed");
+		}
+		fdo_free(privkey);
+	}
+	return ret;
+}
