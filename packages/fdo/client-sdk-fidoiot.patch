-			LOG(LOG_ERROR, "Failed to clear Shared Secret\n");
-			ret = -1;
-		}
-		fdo_free(shse);
-	}
-	if (Ax) {
-		if (memset_s(Ax, size_Ax, 0)) {
-			LOG(LOG_ERROR, "Failed to clear secret data Ax\n");
