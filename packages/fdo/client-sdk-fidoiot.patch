+		LOG(LOG_ERROR, "CBOR encoder: Invalid params");
+		return false;
+	}
+	if (cbor_encoder_close_container_checked(
+		&fdow->current->previous->cbor_encoder,
+		&fdow->current->cbor_encoder) != CborNoError) {
+		LOG(LOG_ERROR, "CBOR encoder: Failed to end Major Type 5 (map)");
+		return false;
+	}
