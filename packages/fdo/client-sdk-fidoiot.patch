-	}
-
-	/* read peer (server) public in ecdh context */
-	ret = mbedtls_mpi_lset(&key_ex_data->ecdh.Qp.Z, 1);
-	if (ret != 0) {
-		LOG(LOG_DEBUG, " mbedtls Qp.z, set fail, returned %d\n", ret);
