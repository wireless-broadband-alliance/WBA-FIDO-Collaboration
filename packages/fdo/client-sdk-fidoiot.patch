+	if (!fdor || !fdor->current) {
+		LOG(LOG_ERROR, "CBOR decoder: Invalid params");
+		return false;
+	}
+	if (cbor_value_advance(&fdor->current->cbor_value) != CborNoError) {
+		LOG(LOG_ERROR, "CBOR decoder: Failed to advance element");
+		return false;
+	}
+	return true;
