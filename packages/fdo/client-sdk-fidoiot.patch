+				       (prot_ctx->tls ? &prot_ctx->ssl : NULL));
+		if (!ret) {
+			ret = connect_to_owner(
+			    prot_ctx->host_ip, prot_ctx->host_port,
+			    &prot_ctx->sock_hdl,
+			    (prot_ctx->tls ? &prot_ctx->ssl : NULL));
+		}
+		break;
+	default:
+		LOG(LOG_ERROR, "%s reached unknown state", __func__);
+		break;
+	}
+	prevstate = prot_ctx->protdata->state;
+	return ret;
+}
+
+/**
+ * fdo_prot_ctx_run responsible for running/maintaining DI, T01, T02
+ * protocol contexts and respond according to the state specified.
+ * Managing the JSON packet to/from device to server is taken care.
+ * Managing the ip/dns-to-ip resolution is taken care.
+ * @param prot_ctx - Pointer of type fdo_prot_ctx_t, holds the all the
+ * information,
+ * @return 0 on success, -1 on error.
+ */
+
+int fdo_prot_ctx_run(fdo_prot_ctx_t *prot_ctx)
+{
+	int ret = 0;
+	int n, size;
+	int retries = 0;
+	fdor_t *fdor = NULL;
+	fdow_t *fdow = NULL;
+
+	if (!prot_ctx || !prot_ctx->protdata) {
+		return -1;
+	}
+	fdor = &prot_ctx->protdata->fdor;
+	fdow = &prot_ctx->protdata->fdow;
+
+	// init connection set-up for send/receive packets
+	if (fdo_con_setup(NULL, NULL, 0)) {
+		LOG(LOG_ERROR, "Connection setup failed!");
+		return -1;
+	}
+
+	for (;;) {
+
+		// initialize the encoder before every write operation
+		if (!fdow_encoder_init(fdow)) {
+			LOG(LOG_ERROR, "Failed to initilize FDOW encoder");
+			return -1;
+		}
+
+		if (prot_ctx->protrun) {
+			(*prot_ctx->protrun)(prot_ctx->protdata);
+		} else {
+			ret = -1;
+			break;
+		}
+
+		/* ==========================================================
+		 */
+		/*  Transmit outbound packet */
+
+		/*  Protocol sets State as FDO_STATE_DONE at the end of
+		 * the*/
+		/*  protocol(DI/T01/TO2) */
+		/*  Hence, when state = FDO_STATE_DONE, we have nothing
+		 * more*/
+		/*  left to */
+		/*  send. Exit!! */
+		if (prot_ctx->protdata->state == FDO_STATE_DONE) {
+			ret = 0;
+			break;
+		}
+
+		if ((fdow->msg_type < FDO_DI_APP_START) ||
+		    (fdow->msg_type > FDO_TYPE_ERROR)) {
+			ret = -1;
+			break;
+		}
+
+		// update the final encoded length in the FDOW block
+		// after every successfull write.
+		if (!fdow_encoded_length(fdow, &fdow->b.block_size)) {
+			LOG(LOG_ERROR,
+			    "Failed to get encoded length in FDOW");
+			ret = -1;
+			break;
+		}
+		LOG(LOG_DEBUG, "%s Tx Request Body length: %zu", __func__,
+		    fdow->b.block_size);
+		LOG(LOG_DEBUG, "%s Tx Request Body:", __func__);
+		fdo_log_block(&fdow->b);
+
+		if (!fdo_prot_ctx_connect(prot_ctx)) {
+			/* Giving up, we tried enough to
+			 * re-establish
+			 */
+			ret = -1;
+			break;
+		}
+
+		size = fdow->b.block_size;
+
+		fdow->b.block[size] = 0;
+		retries = CONNECTION_RETRY;
+		do {
+			n = fdo_con_send_message(
+			    prot_ctx->sock_hdl, FDO_PROT_SPEC_VERSION,
+			    fdow->msg_type, &fdow->b.block[0], size,
+			    prot_ctx->ssl);
+
+			if (n <= 0) {
+				if (fdo_con_disconnect(prot_ctx->sock_hdl,
+						       prot_ctx->ssl)) {
+					LOG(LOG_ERROR, "Error during socket "
+						       "close()");
+					ret = -1;
+					break;
+				}
+
+				if (fdo_connection_restablish(prot_ctx)) {
+					/* Giving up, we tried enough to
+					 * re-establish
+					 */
+					ret = -1;
+					break;
+				}
+			}
+		} while (n < 0 && retries--);
+
+		if (n < 0) {
+			ret = -1;
+			break;
+		}
+
+		// clear the block contents in preparation for the next
+		// FDOW write operation
+		fdo_block_reset(&fdow->b);
+		fdow->b.block_size = prot_ctx->protdata->prot_buff_sz;
+
+		/* ==========================================================
+		 */
+		/*  Receive response */
+
+		uint32_t msglen = 0;
+		uint32_t protver = 0;
+
+		ret = fdo_con_recv_msg_header(prot_ctx->sock_hdl, &protver,
+					      (uint32_t *)&fdor->msg_type,
+					      &msglen, prot_ctx->ssl);
+		if (ret == -1) {
+			LOG(LOG_ERROR, "fdo_con_recv_msg_header() Failed!");
+			ret = -1;
+			break;
+		}
+
+		// clear the block contents in preparation for the next
+		// FDOR read operation
+		fdo_block_reset(&fdor->b);
+		// set the received msg length in the block
+		fdor->b.block_size = msglen;
+
+		if (msglen > 0 && msglen <= prot_ctx->protdata->prot_buff_sz) {
+			retries = CONNECTION_RETRY;
+			n = 0;
+			do {
+				n = fdo_con_recv_msg_body(
+				    prot_ctx->sock_hdl, &fdor->b.block[0],
+				    msglen, prot_ctx->ssl);
+				if (n < 0) {
+					if (fdo_con_disconnect(
+						prot_ctx->sock_hdl,
+						prot_ctx->ssl)) {
+						LOG(LOG_ERROR, "Error during "
+							       "socket "
+							       "close()");
+						ret = -1;
+						break;
+					}
+
+					if (fdo_connection_restablish(
+						prot_ctx)) {
+						/* Giving up, we tried
+						 * enough to
+						 * re-establish
+						 */
+						ret = -1;
+						break;
+					}
+				}
+			} while (n < 0 && retries--);
+
+			if (n <= 0) {
+				LOG(LOG_ERROR, "Socket read not successful "
+					       "after retries!");
+				fdo_block_reset(&fdor->b);
+				ret = -1;
+				break;
+			}
+		}
+
+		if (fdo_con_disconnect(prot_ctx->sock_hdl, prot_ctx->ssl)) {
+			LOG(LOG_ERROR, "Error during socket close()");
+			ret = -1;
+			break;
+		}
+
+		if (msglen > prot_ctx->protdata->prot_buff_sz) {
+			LOG(LOG_ERROR, "Response body size is more than "
+				       "allocated memory");
+			ret = -1;
+			break;
+		}
+
+		LOG(LOG_DEBUG, "%s Rx Response Body: ", __func__);
+		fdo_log_block(&fdor->b);
+
+		/*
+		 * When a REST error message(type 255) is sent over
+		 * network, the received response may have an empty
+		 * body.
+		 */
+		if (msglen == 0 && fdow->msg_type == FDO_TYPE_ERROR) {
+			ret = -1;
+			break;
+		}
+		/* ERROR case ? */
+		if (fdor->msg_type == FDO_TYPE_ERROR) {
+			ret = -1;
+			break;
+		}
+
+		/*
+		 * Now that we have the received buffer, initialize the
+		 * parser for next FDOR read operation and set the
+		 * have_block flag.
+		 */
+		if (!fdor_parser_init(fdor)) {
+			LOG(LOG_ERROR, "Failed to initilize FDOR parser");
+			ret = -1;
+		}
+		if (!fdor_is_valid_cbor(fdor)) {
+			LOG(LOG_ERROR, "Received an invalid CBOR stream");
+			fdo_block_reset(&fdor->b);
+			ret = -1;
+		}
+		fdor->have_block = true;
+	}
+
+	fdo_con_teardown();
+	return ret;
+}
