-/**
- * Free an AES Encrypted Message Body object
- * @param pkt - the object to fdo_free
- * @return none
- */
-void fdo_encrypted_packet_free(fdo_encrypted_packet_t *pkt)
-{
-	if (pkt == NULL) {
-		return;
-	}
-	if (pkt->em_body) {
-		fdo_byte_array_free(pkt->em_body);
-	}
-	if (pkt->hmac) {
-		fdo_hash_free(pkt->hmac);
