+	}
+
+	if (rv->cch != NULL) {
+		fdo_hash_free(rv->cch);
+	}
+
+	if (rv->ui != NULL) {
+		fdo_free(rv->ui);
+	}
+
+	if (rv->ss != NULL) {
+		fdo_string_free(rv->ss);
+	}
+
+	if (rv->pw != NULL) {
+		fdo_string_free(rv->pw);
+	}
+
+	if (rv->wsp != NULL) {
+		fdo_string_free(rv->wsp);
+	}
+
+	if (rv->me != NULL) {
